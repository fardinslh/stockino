{
  "name": "stockino/stockino",
  "version": "1.0.0",
  "description": "Inventory and procurement operations for WooCommerce.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "Stockino\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Stockino\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "php vendor/bin/phpunit",
    "lint": "php vendor/bin/phpcs --standard=phpcs.xml.dist"
  }
}
